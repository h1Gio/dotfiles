* {
    font:   "Hack Nerd Font 14";

    background-color:   transparent;
    text-color:         @ebdbb2;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    location:       north;
    y-offset:       calc(50%- 210px);
    width:          480;
    border-radius:  24px;
    border:         4px;
    border-color:   #98971a;

    background-color:   #1d2021;
}

mainbox {
    padding:    12px;
}

inputbar {
    background-color:   #282828;
    border-color:       #98971a;

    border:         4px;
    border-radius:  16px;

    padding:    8px 16px;
    spacing:    8px;
    children:   [ prompt, entry ];
}

prompt {
    text-color: #cc241d;
}

entry {
    placeholder:        "Search";
    placeholder-color:  #fbf1c7;
    text-color:         #fbf1c7;
}

message {
    margin:             12px 0 0;
    border-radius:      16px;
    border-color:       #b8bb26;
    background-color:   #b8bb26;
}

textbox {
    padding:    8px 24px;
}

listview {
    background-color:   #282828;

    margin:     12px 0 0;
    lines:      8;
    columns:    1;
    border: 4px;
    border-radius: 16px;

    fixed-height: false;
}

element {
    padding:        8px 16px;
    spacing:        8px;
    border-radius:  16px;
}

element normal active {
    text-color: #cc241d;
}

element alternate active {
    text-color: #cc241d;
}

element selected normal, element selected active {
    background-color:   #a89984;
}

element-icon {
    size:           1em;
    vertical-align: 0.5;
}

element-text {
    text-color: #fbf1c7;
}

element selected {
    text-color: #282828;
}
